# --- bat ---
alias cat='bat --paging=never'

# --- mc: make directory and cd into it ---
mc() { mkdir -p "$1" && cd "$1"; }

# --- bw (Bitwarden CLI): unlock the vault using libsecret (gnome-keyring) ---
# Same auth model as the desktop app's "Unlock with system authentication"
# toggle: master password lives in gnome-keyring (unlocked at login by
# PAM), CLI pulls it silently to unlock the BW vault for this shell.
#
# First call in a fresh keyring prompts for the master password ONCE
# (`secret-tool store ...`) and persists it. Every subsequent shell can
# `bwu` without typing anything — the keyring is already unlocked from
# PAM at login.
#
# To wipe the stored master password (e.g. after rotating it):
#     secret-tool clear service bitwarden user master
bwu() {
    local pw session
    for attempt in 1 2; do
        # 1. Try the keyring first (silent on subsequent calls).
        if ! pw=$(secret-tool lookup service bitwarden user master 2>/dev/null); then
            # 2. Fall back to interactive prompt — using `read -rs` so
            #    we can validate non-empty BEFORE pushing into libsecret.
            #    secret-tool store's own prompt is harder to validate.
            echo -n "Bitwarden master password (one-time seed): " >&2
            IFS= read -rs pw
            echo >&2
            if [[ -z "$pw" ]]; then
                echo "bwu: empty password — aborting (re-run when ready)." >&2
                return 1
            fi
            printf '%s' "$pw" | secret-tool store \
                --label='Bitwarden master password' \
                service bitwarden user master
        fi
        # 3. Unlock. `--passwordenv` reads from BW_PASSWORD; never let
        #    bw fall through to its own stdin prompt (would hang us).
        session=$(BW_PASSWORD="$pw" command bw unlock --passwordenv BW_PASSWORD --raw 2>/dev/null) || true
        if [[ -n "$session" ]]; then
            export BW_SESSION="$session"
            printf '%s' "$BW_SESSION" | secret-tool store \
                --label='Bitwarden CLI session' \
                service bitwarden type session
            echo "bwu: vault unlocked." >&2
            return 0
        fi
        # 4. Wrong password — purge keyring entry and reprompt. One retry only.
        echo "bwu: that password didn't unlock the vault — wiping cached entry, re-prompting..." >&2
        secret-tool clear service bitwarden user master 2>/dev/null
        pw=""
    done
    echo "bwu: couldn't unlock after retry. Check: bw login --check; bw status" >&2
    return 1
}

# `bw` wrapper: transparent unlock. If vault is locked or BW_SESSION
# is missing/stale, pull the cached session from libsecret; if that's
# also stale, re-run bwu (which uses the master password in libsecret —
# silent unless the keyring has been wiped). End result: every `bw`
# command Just Works in any shell after the user has run bwu once.
#
# Cost: one `bw status` invocation per call to gate the unlock check
# (~100ms). Skip the gate when stdin isn't a TTY (scripts/CI) so we
# don't accidentally prompt during automation.
bw() {
    if [[ -t 0 ]]; then
        if [[ -z "${BW_SESSION:-}" ]]; then
            BW_SESSION=$(secret-tool lookup service bitwarden type session 2>/dev/null) && export BW_SESSION
        fi
        local status
        status=$(command bw status 2>/dev/null | jq -r .status 2>/dev/null)
        if [[ "$status" == "locked" ]] || [[ "$status" == "" ]]; then
            bwu >&2 || return $?
        fi
    fi
    command bw "$@"
}

# --- sudoa: unattended sudo for Claude / scripts (no swipe / type prompt) ---
# Pulls the local password from Bitwarden via ~/.local/bin/claude-askpass
# and feeds it to sudo -A. Use `sudoa <cmd>` instead of `sudo <cmd>` when
# you want sudo to authenticate silently — typical when Claude is running
# a batch and can't drive an interactive auth prompt.
#
# Pre-req: `bwu` once per fresh login (caches the master password in
# libsecret). After that sudoa is silent for the life of the keyring.
#
# Trust model: anyone with an unlocked vault can sudo as you.
# Same surface as the desktop app's "Unlock with system authentication".
sudoa() { SUDO_ASKPASS="$HOME/.local/bin/claude-askpass" command sudo -A "$@"; }

# --- md: glow-style markdown renderer with inline mermaid diagrams ---
# Pipable like glow: `md file.md` or `cat file.md | md`. Each ```mermaid
# fence is rendered to a PNG via mmdc and drawn inline by mdcat (needs a
# terminal with image support — Ghostty/kitty/wezterm/iTerm). With no
# mermaid blocks it's a plain passthrough to mdcat.
# Deps: mdcat (AUR), mmdc (mermaid-cli, [extra]).
# NB: `command cat` below bypasses the cat->bat alias above, which zsh
# would otherwise expand into this function at definition time.
md() {
    emulate -L zsh
    local tmp; tmp=$(mktemp -d) || return
    local doc="$tmp/doc.md"

    # input from file arg or stdin; rewrite mermaid fences -> image refs,
    # extracting each block to tmp/N.mmd
    { [[ -f "$1" ]] && command cat -- "$1" || command cat; } | awk -v dir="$tmp" '
        /^[[:space:]]*```[[:space:]]*mermaid[[:space:]]*$/ {
            n++; f=dir "/" n ".mmd"; print "![](" dir "/" n ".png)"; cap=1; next
        }
        cap && /^[[:space:]]*```[[:space:]]*$/ { cap=0; close(f); next }
        cap { print > f; next }
        { print }
    ' > "$doc"

    # render each extracted diagram (skipped silently if mmdc absent)
    if (( ${+commands[mmdc]} )); then
        for m in "$tmp"/*.mmd(N); do
            mmdc -i "$m" -o "${m%.mmd}.png" -t dark -b transparent >/dev/null 2>&1
        done
    fi

    command mdcat "$doc"
    rm -rf "$tmp"
}

# --- ffnc: fnclaude from LOCAL working-tree source, renderer always-on (dev) ---
# Live `fnc` is the stable npm release (installed via `mise use -g
# npm:@fnclaude/cli`); `ffnc` runs the working-tree source at
# ~/src/fnclaude@fnclaude with the in-process renderer forced on
# (FNC_RENDERER=1), so renderer/CLI dev churn never destabilises the
# daily-driver `fnc`. Invoked through the fnc.js node→bun preflight shim
# (NOT `bun` directly — that skips the `--` argv preservation; the shim
# forwards process.env to the bun child, so FNC_RENDERER propagates).
alias ffnc="FNC_RENDERER=1 $HOME/src/fnclaude@fnclaude/packages/cli/bin/fnc.js"

# --- fnc-dev: same working-tree source as ffnc, but renderer OFF ---
# Runs the ~/src/fnclaude@fnclaude working tree WITHOUT FNC_RENDERER, so it
# takes the plain PTY/inherit launch path (renderer dormant). Use to exercise
# the on-disk source as the stable `fnc` would behave — e.g. validating
# non-renderer hotfixes before publishing — without touching the npm install.
alias fnc-dev="$HOME/src/fnclaude@fnclaude/packages/cli/bin/fnc.js"

# --- fncodex: open a repo in VS Code via `fncode`, then close this terminal ---
# Forwards its exact args to `fncode` (resolve repo ref -> exec into `code`),
# and on success exits the shell — closing the terminal window it was typed
# into. `code` launches VS Code detached, so closing the terminal doesn't kill
# it. Must be a function, not an alias, so `"$@"` passes through and `exit`
# runs in the interactive shell. `&& exit` guards it: if `fncode` fails (bad or
# ambiguous ref, clone error) the shell stays open so the error is visible.
fncodex() {
  fncode "$@" && exit
}

# --- cloudlog: read a Claude Code cloud session's transcript, read-only ---
# Attaching to a cloud session (`claude --cloud <session_id>`) is behind the
# server-side `tengu_remote_backend` gate and is off for this account, and
# `claude --teleport <id>` migrates the session down to a local one (switching
# git branches to match). This hits the same endpoint teleport reads from —
# GET /v1/code/sessions/<id>/teleport-events — without either side effect, so
# the cloud session keeps running untouched. Headers mirror the CLI's own
# getOAuthHeaders() plus x-organization-uuid.
#   cloudlog <session_id>        assistant turns only (default)
#   cloudlog <session_id> --all  every event, as raw JSON lines
# Pairs with `claude -p "<msg>" --cloud <session_id>` to send.
cloudlog() {
  local sid=$1
  if [[ -z $sid ]]; then
    print -u2 "usage: cloudlog <session_id> [--all]"
    return 2
  fi

  local tok=$(jq -r '.claudeAiOauth.accessToken' ~/.claude/.credentials.json)
  local org=$(jq -r '.oauthAccount.organizationUuid' ~/.claude.json)
  if [[ -z $tok || $tok == null ]]; then
    print -u2 "cloudlog: no OAuth token — run 'claude /login'"
    return 1
  fi

  local body=$(curl -sf \
    "https://api.anthropic.com/v1/code/sessions/${sid}/teleport-events" \
    -H "Authorization: Bearer ${tok}" \
    -H "anthropic-version: 2023-06-01" \
    -H "anthropic-client-platform: cli" \
    -H "x-organization-uuid: ${org}") || {
    print -u2 "cloudlog: fetch failed for ${sid}"
    return 1
  }

  if [[ $2 == --all ]]; then
    print -r -- $body | jq -c '.data[]'
  else
    print -r -- $body | jq -r '.data[]
      | select(.event_type == "assistant")
      | .payload.message.content[]?.text // empty'
  fi
}
