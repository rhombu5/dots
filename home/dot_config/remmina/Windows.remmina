[remmina]
name=Windows
group=
protocol=RDP
server=127.0.0.1
username=Docker
domain=
password=
resolution_mode=2
resolution_width=0
resolution_height=0
dynamic_resolution=1
colordepth=66
network=lan
security=nla
cert_ignore=1
sound=local
microphone=1
disableclipboard=0
sharefolder=/home/tom
shareprinter=1
sharesmartcard=1
multimon=1
glyph_cache=1
viewmode=4
window_maximize=1
quality=9
ssh_tunnel_enabled=0
