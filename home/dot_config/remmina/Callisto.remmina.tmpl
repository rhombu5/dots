[remmina]
name=Callisto
group=
protocol=RDP
server={{ .callisto_rdp_host }}
username={{ .callisto_rdp_user }}
domain={{ .callisto_rdp_domain }}
password=
resolution_mode=2
resolution_width=0
resolution_height=0
dynamic_resolution=1
colordepth=32
network=auto
security=nla
cert_ignore=1
sound=local
microphone=1
disableclipboard=0
sharefolder=/home/{{ .chezmoi.username }}
shareprinter=1
sharesmartcard=1
multimon=1
glyph_cache=1
viewmode=4
window_maximize=1
quality=9
ssh_tunnel_enabled=0
