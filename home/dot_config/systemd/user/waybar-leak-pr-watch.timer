[Unit]
Description=Weekly check for the upstream waybar taskbar-leak fix
Requires=waybar-leak-pr-watch.service

[Timer]
# Monday mornings. Persistent=true means a machine that was asleep on Monday
# still runs the check when it wakes — this watch is only useful if it cannot
# silently skip weeks, which is exactly what a non-persistent timer would do.
OnCalendar=Mon *-*-* 09:00:00
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
