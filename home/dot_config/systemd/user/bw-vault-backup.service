[Unit]
Description=Archive a known-good copy of the Bitwarden vault cache
Documentation=file:%h/.local/bin/bw-vault-backup

# Triggered by bw-vault-backup.path on every close-after-write of either
# data.json. The desktop app rewrites its file once a minute and in quick
# bursts at boot/resume; the default start limit (5 starts / 10s) reads such
# a burst as a crash loop, fails the service, and takes the .path unit down
# with 'unit-start-limit-hit' — leaving the vault unwatched until a manual
# reset-failed (observed 2026-08-14). A oneshot that validates and exits
# cannot crash-loop, so the limiter protects nothing here. Disable it.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=%h/.local/bin/bw-vault-backup

# The script validates before it archives and refuses rather than fails, so a
# non-zero exit here means something genuinely unexpected (jq missing, backup
# dir unwritable). Let that surface in the journal instead of being retried.
Restart=no

# Touches only its own state directory and reads two files under ~/.config.
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
NoNewPrivileges=true
