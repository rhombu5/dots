[Unit]
Description=Daily trial of new Claude Code versions
Requires=claude-version-watch.service

[Timer]
# 05:00 keeps the ~350 MB tarball fetch out of working hours. It does NOT need
# an idle machine: the trial runs entirely out-of-tree, so live Claude Code
# sessions are unaffected. Persistent=true catches up after a suspend.
OnCalendar=*-*-* 05:00:00
Persistent=true
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
