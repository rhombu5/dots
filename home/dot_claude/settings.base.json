{
  "env": {
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/tom/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "claude-code-worktree-paths@fnrhombus-plugins": true
  },
  "extraKnownMarketplaces": {
    "fnrhombus-plugins": {
      "source": {
        "source": "github",
        "repo": "fnrhombus/claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "xhigh",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "5m",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "autoScrollEnabled": true,
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false,
  "preferredNotifChannel": "ghostty",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "repoSettings": {
    "cloneTemplate": "~/src/{repo}@{owner}",
    "worktreeTemplate": "~/src/{repo}@{owner}+{input}",
    "branchTemplate": "{input}",
    "additionalSrcDirs": [
      "~/.local/src",
      "~/code",
      "~/dev",
      "~/projects",
      "~/Projects",
      "~/workspace",
      "~/repos",
      "~/git",
      "~/go/src/*/*",
      "/usr/local/src",
      "/usr/src",
      "~/.cache/yay",
      "/opt"
    ]
  }
}
