#!/usr/bin/env bash
# chezmoi modify_ script: emits the desired ~/.claude/settings.json.
# Starts from the LIVE file's key order and overwrites each stable key's
# value from the base snapshot; the churny, TUI-written "unstable" keys keep
# whatever the live file currently holds. Building on live's order (rather
# than base's) is deliberate: the TUI rewrites settings.json with its own key
# order, and a pure reorder used to read as chezmoi drift and wedge the
# repo's pre-commit `chezmoi verify` hook. Values are still base-authoritative.
# Any other key present live but absent from base is assumed volatile too
# (e.g. a new app-written flag) and passed through as-is, with a
# non-blocking warning to stderr so it's visible instead of silent.
# stdin = current live target (piped by chezmoi); may be empty on first apply.
set -euo pipefail

base="${HOME}/.claude/settings.base.json"
live_json="$(cat)"
# Distinguish "first apply on a fresh machine" (empty stdin) from "existing file
# that simply lacks a key". A volatile key is seeded from base only in the
# former case. Deciding that per-key instead conflated the two: when the TUI
# dropped `model` from settings.json during a model switch, the fallback below
# re-injected base's value, so `chezmoi verify` reported drift on every run and
# wedged the pre-commit hook until someone noticed. Volatile means live wins —
# including when live says nothing.
if [[ -n "$live_json" ]]; then fresh=false; else fresh=true; live_json='{}'; fi

unstable_keys='["model","effortLevel","modelSettings","verbose","autoScrollEnabled","askUserQuestionTimeout","awaySummaryEnabled"]'

passthrough_keys="$(jq -n -r --slurpfile base "$base" --argjson live "$live_json" --argjson unstable "$unstable_keys" '
    ($base[0]) as $b
    | ($live | keys) - ($b | keys) - $unstable
    | .[]
  ')"

if [[ -n "$passthrough_keys" ]]; then
  echo "modify_settings.json: passing through key(s) not in settings.base.json: $(tr '\n' ' ' <<<"$passthrough_keys")" >&2
fi

jq -n --indent 2 \
  --slurpfile base "$base" \
  --argjson live "$live_json" \
  --argjson unstable "$unstable_keys" \
  --argjson fresh "$fresh" \
  '
    ($base[0]) as $b
    | $live as $l
    | reduce ($b | keys_unsorted[]) as $k (
        $l;
        if ($unstable | index($k)) then
          # volatile: live wins, including when live omits the key entirely.
          # Base seeds a value only on a genuine first apply (empty stdin).
          (if ($l | has($k)) and ($l[$k] != null) then .
           elif $fresh then .[$k] = $b[$k]
           else . end)
        else
          # stable: base is authoritative for the value, live keeps the position
          .[$k] = $b[$k]
        end
      )
  '
