# Per-host shortcuts.
Host callisto
    HostName callisto.rhombus.rocks
    User thoma

# AUR uses a single shared user 'aur'; account is identified by SSH key.
Host aur.archlinux.org
    User aur

# Bitwarden SSH agent — populated by bitwarden-desktop's "Enable SSH agent"
# (the Vaultwarden-backed self-hosted vault). Wildcard so every host uses it.
Host *
    IdentityAgent ~/.bitwarden-ssh-agent.sock
