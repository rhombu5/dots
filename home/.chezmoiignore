# Per-machine override files: CLAUDE.<context>.local.md (and any other
# *.local.md). Never apply to destination — these only ever live on the
# live system, never in source. This entry is defensive in case one is
# created in source by mistake.
**/*.local.md

# Exception: noop's CLAUDE.local.md is the cross-machine user overlay
# alongside fnclaude's read-only base. It IS sourced from dots so the
# personalization applies on every machine; the per-machine .local.md
# convention above doesn't apply because the noop dir is fnclaude's
# (auto-loaded by Claude Code via the standard CLAUDE.local.md sibling).
!.claude/noop/CLAUDE.local.md

# Hyprland monitor layout — machine-specific (resolution, refresh,
# scale, position depend on which displays are attached) and gets
# rewritten by nwg-displays whenever the user reconfigures, which would
# otherwise trigger chezmoi-verify drift on every recalibration. Live
# only; the source copy at home/dot_config/hypr/monitors.conf is kept
# as a starting reference for fresh installs but not applied.
.config/hypr/monitors.conf

# Paths that matugen renders to at runtime. Chezmoi MUST NOT manage these
# or it'll fight with matugen on every wallpaper change / theme-toggle.
#
# These ignore entries are listed in source-tree form (path inside source
# state) but they ALSO must not appear in destination state — never add
# files at these paths to the source tree.
#
# If you find yourself wanting to template one of these, do it through
# matugen's template system (dot_config/matugen/templates/<file>) instead.

dot_config/waybar/colors.css
dot_config/swaync/colors.css
dot_config/fuzzel/colors.ini
dot_config/hypr/colors.conf
dot_config/hypr/hyprlock.colors.conf
dot_config/ghostty/themes/matugen
dot_config/gtk-3.0/gtk.css
dot_config/gtk-4.0/gtk.css
dot_config/qt5ct/colors/matugen.conf
dot_config/qt6ct/colors/matugen.conf
dot_config/yazi/theme.toml
dot_config/helix/themes/matugen.toml
dot_config/zathura/colors.zathurarc
