#!/bin/sh
# hypr-layout-toggle — flip the ACTIVE workspace between dwindle and
# scrolling. Per-workspace, not global: each workspace has its own
# layout that persists across visits AND across Hyprland reloads/reboots.
#
# Bound to Super+Alt+S in binds.conf.
#
# Mechanism (Hyprland 0.54.3 specifics, learned the hard way):
#   - `hyprctl keyword workspace "N,layout:X"` migrates ws N's algo
#     ONLY when N is the active workspace. For inactive workspaces the
#     rule registers but never gets applied to the algo pointer.
#   - `hyprctl reload` re-reads disk and discards in-session keyword
#     state. So the rule has to also live in a sourced config file to
#     survive reloads.
#   - We don't need wpws to re-apply on focus: once a workspace's algo
#     is migrated (by toggle, or by reload reading the file), it sticks.
#
# Two state writes per toggle:
#   1. $XDG_STATE_HOME/hypr-layout/ws-<id>.mode — the per-ws choice
#      (atomic, easy to reason about).
#   2. ~/.config/hypr/runtime-layouts.conf — regenerated from all the
#      .mode files. Sourced from hyprland.conf, so reloads pick it up.
#      The chezmoi source is a `create_` file so chezmoi apply never
#      clobbers what this script wrote.

set -e

active=$(hyprctl activeworkspace -j 2>/dev/null \
    | jq -r '"\(.id)\t\(.tiledLayout // "dwindle")"')
ws_id=$(printf '%s\n' "$active" | cut -f1)
current=$(printf '%s\n' "$active" | cut -f2)

case "$current" in
    scrolling) target=dwindle ;;
    *)         target=scrolling ;;
esac

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hypr-layout"
runtime_conf="$HOME/.config/hypr/runtime-layouts.conf"

mkdir -p "$state_dir"
printf '%s\n' "$target" > "$state_dir/ws-$ws_id.mode"

# Regenerate runtime-layouts.conf from all per-ws state files.
# Atomic: write to .tmp, mv into place. Hyprland reads on next reload.
{
    printf '# Generated by hypr-layout-toggle. Do not edit by hand.\n'
    printf '# One workspace rule per state file in %s.\n' "$state_dir"
    for f in "$state_dir"/ws-*.mode; do
        [ -e "$f" ] || continue
        wid=$(basename "$f" .mode)
        wid=${wid#ws-}
        mode=$(cat "$f")
        case "$mode" in
            dwindle|scrolling|master) ;;
            *) continue ;;
        esac
        printf 'workspace = %s, layout:%s\n' "$wid" "$mode"
    done
} > "$runtime_conf.tmp"
mv "$runtime_conf.tmp" "$runtime_conf"

# Live migration of the active workspace. Hyprland 0.54.3 will only
# migrate the active ws when keyword is called — which is exactly the
# case we're in (the user just pressed Super+Alt+S on this workspace).
if hyprctl keyword workspace "$ws_id,layout:$target" >/dev/null 2>&1; then
    notify-send -t 1500 "Hyprland layout (ws $ws_id)" "→ $target" 2>/dev/null || true
else
    notify-send -u critical -t 3000 "Hyprland layout" \
        "Failed to set ws $ws_id layout=$target." 2>/dev/null || true
    exit 1
fi
