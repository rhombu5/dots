#!/usr/bin/env bash
# Lid switch handler. Wired from Hyprland `binddl` in ~/.config/hypr/binds.conf.
# Owns lid-driven display behavior and invokes the hibernate check on lid close;
# logind defers via /etc/systemd/logind.conf.d/10-lid.conf (Handle*=ignore).
#
# Rule: on lid close, disable eDP-1 if an external monitor is attached (stay-awake
# clamshell, re-enabled via reload on lid open). The hibernate decision is
# delegated to /usr/local/bin/headless-hibernate — hibernate iff lid-closed AND no
# external display connected AND on battery (see arch-setup postinstall 1h-bat).
# This supersedes the old "hibernate on close unless AC+external; unconditional on
# battery" rule, which hibernated a docked machine whenever it dropped to battery.
#
# Approach history (decision lives here, not in commit messages, because the
# next person to touch this needs the why):
#
#   1. monitor=,disable  (initial)
#      Native: Hyprland migrates workspaces + cursor confined to remaining
#      output. The "right" UX, but observed a cascade-crash 2026-05-05 that
#      looked client-fatal; we abandoned it.
#
#   2. dispatch dpms off (2026-05-05)
#      Avoids surface destruction → no client crashes. But: layout is
#      unchanged so cursor still wanders into the dark eDP-1 area, AND
#      misc:{key_press,mouse_move}_enables_dpms wakes the panel on any
#      input from the (lid-close-immune) USB keyboard. Ineffective.
#
#   3. monitor=,mirror  (tested 2026-05-06)
#      Workspaces auto-migrate, cursor maps to external, no client deaths.
#      But the un-mirror cycle leaves eDP-1's wl_output unadvertised to
#      layer-shell clients (waybar's eDP-1 bar never comes back). Needed
#      a disable+reload cycle anyway to restore it.
#
#   4. monitor=,disable  (current)
#      Returned to disable after re-testing on Hyprland 0.54.3 — clients
#      survive cleanly today. Yesterday's "cascade" was actually a
#      pre-existing waybar SIGSEGV that fired ~90s *before* the lid event;
#      we mis-attributed it. Disable is the cleanest match to the desired
#      UX. Lid-open does the reverse via `hyprctl reload`, plus a waybar
#      restart because waybar doesn't reliably re-attach to a re-added
#      output.
set -euo pipefail

action=${1:-}
internal=eDP-1

external_attached() {
    hyprctl monitors -j | jq -e --arg n "$internal" 'any(.[]; .name != $n)' >/dev/null
}

restart_waybar() {
    # Waybar doesn't reliably re-attach per-output bars when an output is
    # re-added at runtime; a fresh process is the simplest reliable fix.
    # waybar.service (Restart=always) owns the process lifecycle now —
    # `systemctl restart` deterministically kills and respawns; the old
    # pkill+setsid approach would race with the unit's auto-respawn and
    # could leave two processes contending for the same bar.
    systemctl --user restart waybar.service
}

case $action in
    close)
        # Record clamshell truth where `hyprctl reload` re-reads it
        # (runtime-monitors.conf via hypr-lid-sync), then apply immediately
        # via keyword — reload-persistence and the instant disable are
        # separate mechanisms.
        "$HOME/.local/bin/hypr-lid-sync"
        # With an external attached we stay awake (clamshell) regardless of
        # power, so disable the internal panel: Hyprland migrates workspaces +
        # toplevels off eDP-1 and confines the cursor to the remaining outputs.
        # Layer-shell surfaces on eDP-1 are destroyed; well-behaved clients
        # survive (if waybar dies in the cascade, lid-open's restart catches it).
        if external_attached; then
            hyprctl keyword monitor "$internal,disable"
        fi
        # Delegate the hibernate decision to the single system-wide condition
        # script (covers the lid-close trigger; udev covers AC-unplug + display
        # disconnect). Runs as the user — polkit rule 49 lets tom hibernate.
        /usr/local/bin/headless-hibernate
        ;;
    open)
        # Drop the runtime-monitors.conf disable override first, then
        # reload: re-applies monitors.conf, bringing eDP-1 back at its
        # configured position/scale and re-binding workspaces 6-9.
        "$HOME/.local/bin/hypr-lid-sync"
        hyprctl reload
        sleep 0.3
        restart_waybar
        ;;
    *)
        echo "usage: $0 {open|close}" >&2
        exit 1
        ;;
esac
