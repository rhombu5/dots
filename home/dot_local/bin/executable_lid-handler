#!/usr/bin/env bash
# Lid switch handler. Wired from Hyprland `binddl` in ~/.config/hypr/binds.conf.
# Owns ALL lid behavior; logind defers via /etc/systemd/logind.conf.d/10-lid.conf
# (Handle*=ignore across the board).
#
# Rule: hibernate on lid close, UNLESS we're on AC AND an external monitor is
# attached — in that case DPMS-off eDP-1 (DPMS-on on lid open).
#
# DPMS instead of `monitor=…,disable` is deliberate: disabling tears down the
# wlr_output, which propagates "invalid object" Wayland protocol errors to any
# client with a surface on eDP-1. That kills waybar, hyprlax, swaync,
# hyprpolkitagent, and any toplevels on workspaces 6-9 (observed 2026-05-05).
# DPMS-off keeps the output configured — surfaces survive, the panel just
# powers down — and clients pick up where they left off on lid open.
set -euo pipefail

action=${1:-}
internal=eDP-1

on_ac() {
    # NB: don't be tempted to write `$(<file 2>/dev/null)` — bash's fast-read
    # idiom returns empty when any redirection is appended, so the test silently
    # always fails. Use `cat` so error suppression works.
    [[ "$(cat /sys/class/power_supply/AC/online 2>/dev/null)" == 1 ]]
}

external_attached() {
    hyprctl monitors -j | jq -e --arg n "$internal" 'any(.[]; .name != $n)' >/dev/null
}

case $action in
    close)
        if on_ac && external_attached; then
            hyprctl dispatch dpms off "$internal"
        else
            systemctl hibernate
        fi
        ;;
    open)
        hyprctl dispatch dpms on "$internal"
        ;;
    *)
        echo "usage: $0 {open|close}" >&2
        exit 1
        ;;
esac
