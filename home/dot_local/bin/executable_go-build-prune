#!/usr/bin/env bash
# Prune stale entries from Go's build cache.
#
# Go's cache has no size cap. It evicts only entries unused for 5+ days, and
# checks at most once a day -- which a workload that recompiles the same module
# many times a day defeats completely. Transformer work on std@fnioc once wrote
# about 40 GB/day into it and filled a 476 GB disk within days, none of it old
# enough for Go's own trim to touch a single file.
#
# Removing an entry is safe in itself: Go treats a missing entry as a cache
# miss and recompiles that one unit. There is no index to corrupt. The one
# real hazard is interrupting a build that is actively compiling, so below
# the size cap this refuses to run at all while a Go toolchain process is
# alive. It does NOT skip based on how recently the cache was last written to
# -- under a continuous stream of builds the cache is written to constantly,
# and a guard keyed on that would never fire.

set -euo pipefail

CACHE="${GOCACHE:-$HOME/.cache/go-build}"
[ -d "$CACHE" ] || exit 0

BASE_AGE_MIN=240   # 4h baseline age prune -- tight enough to survive a busy fan-out day
CAP_BYTES=$((40 * 1024 * 1024 * 1024))  # size-cap backstop
FLOOR_AGE_MIN=60    # never touch anything newer than this, baseline or backstop

# Anything that could be compiling Go right now. `compile`, `link` and `asm` are
# the toolchain workers the go driver spawns; matching only `go` would miss a
# build sitting mid-compile with the driver blocked in wait().
#
# Exact name matches only (-x, against comm). A -f match on a substring like
# "ttsc" also hits any shell whose command line merely mentions it -- an editor,
# a grep, an agent session -- which would wedge this into skipping forever.
# Nothing is lost by leaving it out: ttsc builds its sidecar through this same
# toolchain, so a sidecar compile shows up as `compile`/`link`/`go` regardless.
build_in_flight() {
  pgrep -x go >/dev/null 2>&1 ||
    pgrep -x compile >/dev/null 2>&1 ||
    pgrep -x link >/dev/null 2>&1 ||
    pgrep -x asm >/dev/null 2>&1
}

cache_size_bytes() {
  du -sb "$CACHE" 2>/dev/null | awk '{ print $1 }'
}

# Below the cap, never interrupt a live build. At or above it, age-pruning old
# objects is safe alongside a live compile -- the same trade the old avail-
# based system made for its emergency tier, re-keyed to the cache's own size
# instead of free disk space (df-reported free space didn't track the
# pressure that mattered here; the cache's own size does).
size=$(cache_size_bytes)
if [ "${size:-0}" -lt "$CAP_BYTES" ] && build_in_flight; then
  echo "skip: build in flight"
  exit 0
fi

# -printf ahead of -delete so find reports each file's size as it removes it:
# one tree walk, instead of a du before and a du after.
prune_older_than() {
  find "$CACHE" -type f -mmin "+$1" ! -name trim.txt ! -name README \
    -printf '%s\n' -delete 2>/dev/null | awk '{ s += $1 } END { print s + 0 }'
}

freed=$(prune_older_than "$BASE_AGE_MIN")
find "$CACHE" -mindepth 1 -type d -empty -delete 2>/dev/null || true

# Backstop: the 4h baseline is a no-op most ticks. If a wide-enough fan-out of
# builds still leaves the cache oversized, prune progressively younger --
# halving the age window each pass -- until it's back under the cap or the
# floor is reached. The floor exists because anything newer than an hour is
# plausibly still part of some build's working set.
age=$BASE_AGE_MIN
size=$(cache_size_bytes)
while [ "${size:-0}" -gt "$CAP_BYTES" ] && [ "$age" -gt "$FLOOR_AGE_MIN" ]; do
  age=$(( age / 2 ))
  [ "$age" -lt "$FLOOR_AGE_MIN" ] && age=$FLOOR_AGE_MIN
  extra=$(prune_older_than "$age")
  freed=$(( freed + extra ))
  find "$CACHE" -mindepth 1 -type d -empty -delete 2>/dev/null || true
  size=$(cache_size_bytes)
done

printf 'freed=%sGB size_after=%sGB\n' \
  "$(awk -v b="$freed" 'BEGIN { printf "%.1f", b / 1073741824 }')" \
  "$(awk -v b="${size:-0}" 'BEGIN { printf "%.1f", b / 1073741824 }')"
