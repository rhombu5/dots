#!/usr/bin/env bash
# hypr-cheatsheet — searchable GUI cheatsheet of every active Hyprland
# binding. Reads the live state via `hyprctl binds -j` and feeds the
# list through fuzzel's dmenu mode. Themed via matugen's fuzzel
# template, so it looks like the rest of the desktop.
#
# Bound to Super+/ in binds.conf.
#
# Format per row:  [Category] Description           MODS+KEY
# Sorted by category, then description, so related actions cluster
# (e.g., all "Open ..." quicklaunches together, all "Focus window ..."
# together) and you can fuzzel-search by what the binding *does*
# rather than memorizing the chord.
#
# Selecting an entry just dismisses; we don't auto-fire the action
# because dispatchers like `killactive` would do unexpected things to
# whatever was focused before fuzzel popped open.

set -euo pipefail

if ! command -v hyprctl >/dev/null; then
    notify-send -u critical "hypr-cheatsheet" "hyprctl not on PATH; are you in Hyprland?" 2>/dev/null
    exit 1
fi

# Active layout drives category labels for layout-specific dispatchers
# (layoutmsg → scrolling-only; togglesplit → dwindle-only). Binds that
# silently no-op in the current layout get an "(off)" suffix so the
# user can see what's actually firing right now. Layout is per-workspace
# (see hypr-layout-toggle), so read the active workspace's tiledLayout.
LAYOUT=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.tiledLayout // ""')

mods_to_label() {
    case "$1" in
        0)   echo "" ;;
        1)   echo "Shift" ;;
        4)   echo "Ctrl" ;;
        5)   echo "Ctrl+Shift" ;;
        8)   echo "Alt" ;;
        9)   echo "Alt+Shift" ;;
        12)  echo "Ctrl+Alt" ;;
        13)  echo "Ctrl+Alt+Shift" ;;
        64)  echo "Super" ;;
        65)  echo "Super+Shift" ;;
        68)  echo "Ctrl+Super" ;;
        69)  echo "Ctrl+Super+Shift" ;;
        72)  echo "Super+Alt" ;;
        73)  echo "Super+Alt+Shift" ;;
        *)   echo "mod${1}" ;;
    esac
}

# Derive a category from the dispatcher + arg. Used to group related
# bindings in the cheatsheet output. Categories are short so the
# bracketed prefix doesn't crowd the description column.
categorize() {
    local dispatcher="$1" arg="$2" description="$3"
    local bucket=""
    # Description prefix wins over dispatcher heuristics — lets a bind
    # opt into a category by naming itself. Sub-categories nest with a
    # second colon: "Layout: Mode: …" → [Layout:Mode]. More-specific
    # patterns must come first so they win against the bare "layout*".
    case "${description,,}" in
        "layout: mode:"*)           echo "Layout:Mode"        ; return ;;
        "layout: misc:"*)           echo "Layout:Misc"        ; return ;;
        "layout: focus: window:"*)  echo "Layout:Focus:Window"; return ;;
        "layout: focus: tabs:"*)    echo "Layout:Focus:Tabs"  ; return ;;
        "layout: focus:"*)          echo "Layout:Focus"       ; return ;;
        "layout: move: window:"*)   echo "Layout:Move:Window" ; return ;;
        "layout: move:"*)           echo "Layout:Move"        ; return ;;
        "layout: resize:"*)         echo "Layout:Resize"      ; return ;;
        layout*)                    echo "Layout"             ; return ;;
    esac
    case "$dispatcher" in
        layoutmsg)
            # layoutmsg routes to whichever layout is active, so the
            # arg tells us which layout the bind is *for*: togglesplit /
            # swapsplit / preselect are dwindle-only; swapcol is the
            # scrolling-layout analogue of movewindow l/r and goes into
            # Layout:Move; the rest (colresize, promote, togglefit, fit)
            # are scrolling-only column manipulation.
            local target
            case "$arg" in
                togglesplit*|swapsplit*|preselect*) target="dwindle"  ; bucket="Layout:Dwindle" ;;
                "swapcol "*|promote*)               target="scrolling"; bucket="Layout:Move"    ;;
                "colresize "*)                      target="scrolling"; bucket="Layout:Resize"  ;;
                *)                                  target="scrolling"; bucket="Layout:Scroll"  ;;
            esac
            if [[ "$LAYOUT" == "$target" ]]; then echo "$bucket"
            else echo "$bucket (off)"; fi ;;
        killactive|togglefloating|togglegroup|fullscreen|pin)
            echo "Window" ;;
        movefocus)
            echo "Layout:Focus:Window" ;;
        movewindow|movewindowpixel|moveactive)
            echo "Layout:Move:Window" ;;
        resizewindow|resizeactive|resizewindowpixel)
            echo "Layout:Resize" ;;
        workspace|movetoworkspace|movetoworkspacesilent|togglespecialworkspace)
            echo "Workspace" ;;
        submap)
            echo "Layout:Mode" ;;
        exec)
            case "$arg" in
                *swayosd-client*|*playerctl*)        echo "Media" ;;
                *hyprshot*|*satty*)                  echo "Screenshot" ;;
                *systemctl*hibernate*|*loginctl*lock*|*wleave*) echo "Power" ;;
                *theme-toggle*|*wallpaper-rotate*)    echo "Theme" ;;
                *hyprctl*reload*|*hyprpicker*)        echo "Hyprland" ;;
                *hypr-cheatsheet*)                    echo "Help" ;;
                *control-panel*|*pkill*waybar*)       echo "System" ;;
                *cliphist*|*fuzzel*emoji*)            echo "Pickers" ;;
                *swaync-client*)                      echo "Notifications" ;;
                *)                                    echo "Apps" ;;
            esac ;;
        *)
            echo "Misc" ;;
    esac
}

format_bind() {
    local modmask="$1" key="$2" description="$3" dispatcher="$4" arg="$5"
    local label combo category rhs
    label=$(mods_to_label "$modmask")
    if [[ -z "$label" ]]; then combo="$key"
    else combo="${label}+${key}"; fi

    if [[ -n "$description" && "$description" != "null" ]]; then
        rhs="$description"
    elif [[ -z "$arg" || "$arg" == "null" ]]; then
        rhs="$dispatcher"
    else
        rhs="$dispatcher $arg"
    fi
    category=$(categorize "$dispatcher" "$arg" "$description")

    # Layout-inactive binds (the "(off)" suffix categorize() emits for
    # layoutmsg targeting the wrong layout) are dropped entirely —
    # showing them just adds noise for binds that won't fire.
    [[ "$category" == *" (off)" ]] && return

    # Strip category-redundant prefixes from the rhs so a row doesn't
    # read "[Layout:Focus] Focus window left". Two conventions:
    #   1. Category-path prefix: "Layout:Mode" → strip "Layout: Mode: "
    #      (every ":" in the category becomes ": " in the description).
    #   2. Legacy form for movefocus/movewindow descriptions, which
    #      don't carry the Layout: prefix — strip "<last> window "
    #      (e.g. category "Layout:Focus" + "Focus window left" → "left").
    local path_prefix="${category//:/: }: "
    local last_token="${category##*:}"
    shopt -s nocasematch
    if   [[ "$rhs" == "$path_prefix"* ]];                                   then rhs="${rhs:${#path_prefix}}"
    elif [[ "$rhs" =~ ^${last_token}[[:space:]]+window[[:space:]]+(.+)$ ]]; then rhs="${BASH_REMATCH[1]}"
    fi
    shopt -u nocasematch

    # Normalize vim variants so they collapse into the arrow variant's
    # row. Two description shapes carry the marker:
    #   "X (vim)"   → "X"        (e.g. resize submap, focus/move down/up)
    #   "X vim (Y)" → "X (Y)"    (focus/move left/right carry an edge
    #                             parenthetical between key and "vim")
    # `order` controls within-group combo ordering so the arrow version
    # appears first in the merged "left / h" string.
    local order=1
    if   [[ "$rhs" == *" vim ("* ]]; then rhs="${rhs// vim (/ (}"; order=2
    elif [[ "$rhs" == *" (vim)" ]];  then rhs="${rhs% (vim)}";      order=2
    fi

    # Emit TSV; the aggregator downstream merges rows that share
    # (category, description) and joins their combos with " / ".
    printf '%s\t%s\t%d\t%s\n' "$category" "$rhs" "$order" "$combo"
}

# First entry is a pinned reminder of where the binds live, so anyone
# poking around the cheatsheet has a one-key path to "open the file
# and edit." No GUI keybind editor exists for Hyprland — the source
# of truth is the conf file. Selecting it dismisses (we don't auto-
# launch an editor; the user might prefer code/helix/$EDITOR).
{
    printf '[%-13s] %-40s   %s\n' "Source" "~/.config/hypr/binds.conf  (edit to add/remove)" "—"
    printf '[%-13s] %-40s   %s\n' "Source" "$ chezmoi edit ~/.config/hypr/binds.conf" "—"

    hyprctl binds -j 2>/dev/null \
      | jq -r '.[] | [.modmask, .key, (.description // ""), .dispatcher, (.arg // "")] | @tsv' \
      | while IFS=$'\t' read -r modmask key description dispatcher arg; do
            format_bind "$modmask" "$key" "$description" "$dispatcher" "$arg"
        done \
      | sort -t$'\t' -k1,1 -k2,2 -k3,3n \
      | awk -F'\t' '
          # left/right/up/down → ← → ↑ ↓ in both description and combo,
          # word-bounded so "BrightnessDown" stays intact but the bare
          # word "Down" turns into a glyph.
          function arrowize(s) {
              gsub(/\<left\>/,  "←", s); gsub(/\<Left\>/,  "←", s)
              gsub(/\<right\>/, "→", s); gsub(/\<Right\>/, "→", s)
              gsub(/\<up\>/,    "↑", s); gsub(/\<Up\>/,    "↑", s)
              gsub(/\<down\>/,  "↓", s); gsub(/\<Down\>/,  "↓", s)
              return s
          }
          # When joining the vim variant onto the arrow combo, strip the
          # shared "MODS+" prefix so we render "Super+Ctrl+←/h" instead
          # of "Super+Ctrl+←/Super+Ctrl+h".
          function strip_mod_prefix(target, source,   n) {
              n = length(source)
              while (n > 0 && substr(source, n, 1) != "+") n--
              if (n == 0) return target
              if (substr(target, 1, n) == substr(source, 1, n)) return substr(target, n + 1)
              return target
          }
          function flush() { if (cat != "") printf "[%-20s] %-40s   %s\n", cat, desc, combos }
          {
              d = arrowize($2); c = arrowize($4)
              if ($1 != cat || d != desc) { flush(); cat=$1; desc=d; combos=c; first=c }
              else                        { combos = combos "/" strip_mod_prefix(c, first) }
          }
          END { flush() }
        '
} | fuzzel --dmenu --width 100 --lines 20 --prompt "Hyprland binds: " >/dev/null
