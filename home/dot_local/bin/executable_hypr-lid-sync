#!/usr/bin/env bash
# hypr-lid-sync — regenerate ~/.config/hypr/runtime-monitors.conf so any
# `hyprctl reload` re-applies the CURRENT clamshell truth instead of
# resurrecting eDP-1 from monitors.conf.
#
# Why: monitors.conf (nwg-displays-generated, chezmoi-ignored) enables
# eDP-1 unconditionally, and the clamshell path (lid-handler close,
# hypr-plugins-on-login phase 4) disables the panel with a `hyprctl
# keyword` override that any config reload wipes. Observed 2026-07-09:
# lid closed for a week, machine clamshell-docked, and a mid-session
# reload resurrected the phantom eDP-1 — doubling waybar bars and
# hyprmural surfaces (workspaces 6-9 are pinned to eDP-1 in
# workspaces.conf) until the next manual keyword-disable.
#
# Fix is the runtime-layouts.conf pattern: hyprland.conf sources this
# generated file AFTER monitors.conf, so on every re-parse the last
# eDP-1 rule wins and a reload converges on lid truth.
#
# Callers: lid-handler (lid open/close binddl) and hypr-plugins-on-login
# (session start, before the hyprpm reload). Idempotent; safe ad hoc.
#
# Decision mirrors lid-handler close: disable eDP-1 iff lid closed AND
# an external output is attached. Everything else (lid open, no
# external, unreadable lid state, no live compositor) leaves eDP-1
# governed by monitors.conf — worst case is a phantom monitor, never
# zero displays.
set -euo pipefail

internal=eDP-1
runtime_conf="$HOME/.config/hypr/runtime-monitors.conf"

lid_closed() {
    awk '/state/ {print $2}' /proc/acpi/button/lid/*/state 2>/dev/null | grep -q closed
}

external_attached() {
    hyprctl monitors -j 2>/dev/null | jq -e --arg n "$internal" 'any(.[]; .name != $n)' >/dev/null
}

# Atomic: write to .tmp, mv into place (mirrors hypr-layout-toggle).
{
    printf '# Clamshell override for %s. Generated by hypr-lid-sync. Do not edit\n' "$internal"
    printf '# by hand — rewritten on every lid event and at session start. Sourced\n'
    printf '# from hyprland.conf AFTER monitors.conf so this rule wins on reload.\n'
    if lid_closed && external_attached; then
        printf 'monitor = %s, disable\n' "$internal"
    else
        printf '# (lid open or no external attached: %s governed by monitors.conf)\n' "$internal"
    fi
} > "$runtime_conf.tmp"
mv "$runtime_conf.tmp" "$runtime_conf"
