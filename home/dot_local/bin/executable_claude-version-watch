#!/usr/bin/env bash
# Daily trial of newly-published Claude Code versions, with automatic rollback.
#
# Claude Code auto-updates itself. On 2026-08-24 it walked onto 2.1.242/2.1.243,
# both of which segfault at startup -- `claude --version` exits 139 with a core
# dump. Because every wrapper (fnc, subagent spawns, anything shelling out to
# claude) launches it as a subprocess, the whole toolchain looked broken while
# the actual fault was one bad upstream build. The response was to roll back to
# 2.1.241 and set DISABLE_AUTOUPDATER=1 so the updater couldn't drag the install
# straight back onto the crashing build.
#
# That pin is safe but it rots: left alone it freezes Claude Code forever. This
# script is the thing that unfreezes it. Once a day it asks whether upstream has
# published anything NEWER than the newest version known to be broken. If so it
# installs that version and runs it. Two outcomes:
#
#   works   -> the bad patch is over. Record it as the new known-good, delete
#              DISABLE_AUTOUPDATER from the chezmoi-managed settings, apply, and
#              hand normal auto-updating back to Claude Code.
#   broken  -> that version becomes the new baseline, and the watch from here on
#              is for something newer than IT. Reinstall the known-good build so
#              the machine is never left sitting on a crashing one.
#
# The invariant that matters: a candidate is NEVER installed before it has been
# proven to start. The trial happens entirely inside a scratch directory -- the
# tarball is fetched with `npm pack`, unpacked, and the binary inside it is run
# from there. A broken candidate therefore has zero blast radius: nothing was
# replaced, so nothing needs rolling back.
#
# This is why the script is safe to run with live Claude Code sessions open. An
# earlier revision refused to start while any claude process existed, on the
# theory that replacing claude.exe could SIGBUS a running session. That guard
# turned out to be both wrong and fatal to the whole design: wrong because npm
# unlinks and recreates rather than truncating in place, so a running process
# keeps its original inode mapped (observed directly -- a reinstall was done
# under a live session with no ill effect); fatal because these sessions are
# long-lived and the machine rarely reboots, so the guard tripped on every
# single fire and the watcher sat inert for days without ever trialling
# anything. An automation that silently never runs is worse than none.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-version-watch"
STATE_FILE="$STATE_DIR/state.json"
LOG_FILE="$STATE_DIR/log"

PKG="@anthropic-ai/claude-code"
NPM="$HOME/.local/share/mise/shims/npm"
CLAUDE="$HOME/.local/share/mise/shims/claude"
DOTS_SETTINGS="$HOME/src/dots@rhombu5/home/dot_claude/settings.base.json"

mkdir -p "$STATE_DIR"

log() {
    printf '%s  %s\n' "$(date -Is)" "$*" >> "$LOG_FILE"
}

notify() {
    local urgency=$1 title=$2 body=$3
    log "NOTIFY [$urgency] $title -- $body"
    notify-send --urgency="$urgency" --app-name="claude-version-watch" "$title" "$body" 2>/dev/null || true
}

# True when $1 is a strictly newer version than $2, by version sort.
newer_than() {
    local candidate=$1 baseline=$2
    [ "$candidate" != "$baseline" ] || return 1
    [ "$(printf '%s\n%s\n' "$candidate" "$baseline" | sort -V | tail -1)" = "$candidate" ]
}

read_state() {
    local key=$1 fallback=$2
    jq -r --arg k "$key" --arg d "$fallback" '.[$k] // $d' "$STATE_FILE" 2>/dev/null || printf '%s' "$fallback"
}

write_state() {
    local good=$1 bad=$2
    jq -n --arg good "$good" --arg bad "$bad" \
        '{known_good: $good} + (if $bad == "" then {} else {known_bad: $bad} end)' \
        > "$STATE_FILE.tmp" && mv -f "$STATE_FILE.tmp" "$STATE_FILE"
}

# Install a specific version. Returns npm's exit status.
install_version() {
    "$NPM" install -g "$PKG@$1" >> "$LOG_FILE" 2>&1
}

# Run a binary with --version and confirm it starts and reports $expected.
# A segfaulting build exits 139 here rather than printing anything.
probe_binary() {
    local binary=$1 expected=$2 output status
    output=$(timeout 60 "$binary" --version 2>&1)
    status=$?
    log "probe($binary): exit=$status output=${output:-<none>}"
    [ "$status" -eq 0 ] || return 1
    [[ "$output" == "$expected"* ]]
}

# Install a candidate into a throwaway prefix and run the binary from there.
# Nothing outside the scratch directory is touched, so a crashing candidate
# costs nothing and needs no rollback. The scratch dir is removed either way.
#
# `npm install --prefix` rather than `npm pack`: the published tarball is only
# ~28 KB and contains no executable at all. The ~250 MB native binary is a
# platform-specific optional dependency fetched by the package's postinstall
# script, so an unpacked tarball merely prints "claude native binary not
# installed" and exits 1 -- which a naive probe would score as a crash, marking
# every candidate broken forever. A prefixed install runs postinstall and
# produces a genuinely runnable tree.
#
# Deliberately NOT under /tmp: that is tmpfs here, and this writes ~250 MB of
# real memory if placed there. $XDG_CACHE_HOME is on disk.
trial_candidate() {
    local version=$1
    local scratch result

    scratch=$(mktemp -d "${XDG_CACHE_HOME:-$HOME/.cache}/claude-version-watch.XXXXXX") || return 1

    if ! "$NPM" install --prefix "$scratch" "$PKG@$version" >> "$LOG_FILE" 2>&1; then
        log "could not install $version into the scratch prefix"
        rm -rf "$scratch"
        return 1
    fi

    probe_binary "$scratch/node_modules/$PKG/bin/claude.exe" "$version"
    result=$?

    rm -rf "$scratch"
    return $result
}

# Delete DISABLE_AUTOUPDATER from the chezmoi source, apply it, and commit
# locally. Deliberately does NOT push -- an unattended timer should not be
# writing to a remote. The notification tells Tom there's a commit waiting.
reenable_autoupdate() {
    if [ ! -f "$DOTS_SETTINGS" ]; then
        log "dots settings not found at $DOTS_SETTINGS; skipping auto-update re-enable"
        return 1
    fi

    jq 'del(.env.DISABLE_AUTOUPDATER)' "$DOTS_SETTINGS" > "$DOTS_SETTINGS.tmp" \
        && mv -f "$DOTS_SETTINGS.tmp" "$DOTS_SETTINGS" || return 1

    # settings.json is produced by a modify_ script that reads the LIVE
    # settings.base.json, so the base has to land before settings is rebuilt.
    chezmoi apply "$HOME/.claude/settings.base.json" "$HOME/.claude/settings.json" >> "$LOG_FILE" 2>&1 || return 1

    git -C "$(dirname "$DOTS_SETTINGS")" add "$DOTS_SETTINGS" >> "$LOG_FILE" 2>&1
    git -C "$(dirname "$DOTS_SETTINGS")" commit -q \
        -m "claude/settings: lift DISABLE_AUTOUPDATER — upstream is healthy again" \
        >> "$LOG_FILE" 2>&1
}

# ---- guards ------------------------------------------------------------------

if [ ! -f "$STATE_FILE" ]; then
    log "no state file at $STATE_FILE; nothing to compare against, exiting"
    exit 0
fi

known_good=$(read_state known_good "")
known_bad=$(read_state known_bad "")

if [ -z "$known_bad" ]; then
    log "no known_bad recorded — the pin is presumed already lifted; nothing to watch"
    exit 0
fi

latest=$("$NPM" view "$PKG" version 2>/dev/null | tr -d '[:space:]')
if [ -z "$latest" ]; then
    log "could not reach the registry; will retry tomorrow"
    exit 0
fi

if ! newer_than "$latest" "$known_bad"; then
    log "latest=$latest is not newer than known_bad=$known_bad; nothing to try"
    exit 0
fi

# ---- trial -------------------------------------------------------------------

log "trialling $latest out-of-tree (known_good=$known_good, known_bad=$known_bad)"

if ! trial_candidate "$latest"; then
    # Either the candidate crashed or it could not be fetched. Both mean "do
    # not promote"; recording it as the baseline is only correct for the
    # former, but treating a fetch failure as a bad version merely delays the
    # next attempt to the next published release, which is acceptable and far
    # safer than promoting something unproven.
    log "$latest did not start cleanly; it becomes the new baseline. Install untouched at $known_good."
    write_state "$known_good" "$latest"
    notify normal "Claude Code $latest is broken too" \
        "Nothing was installed — you're still on $known_good. Now watching for newer than $latest."
    exit 0
fi

# ---- promotion ---------------------------------------------------------------

log "$latest starts cleanly out-of-tree; installing it for real"

if ! install_version "$latest"; then
    log "install of $latest failed after a clean trial; leaving $known_good in place"
    notify critical "Claude Code $latest passed its trial but would not install" \
        "Still on $known_good and still pinned. Install it by hand."
    exit 1
fi

if ! probe_binary "$CLAUDE" "$latest"; then
    # Passed out-of-tree but not in place. Unexpected; restore and stop.
    log "$latest failed after installation despite a clean trial; restoring $known_good"
    install_version "$known_good"
    write_state "$known_good" "$latest"
    notify critical "Claude Code $latest failed after install" \
        "It passed an isolated trial then crashed in place. Restored $known_good; still pinned."
    exit 1
fi

write_state "$latest" ""

if reenable_autoupdate; then
    notify normal "Claude Code $latest is healthy" \
        "Installed and auto-updates re-enabled. A dots commit is waiting to be pushed."
else
    notify critical "Claude Code $latest is healthy, but the pin is still in place" \
        "Could not edit or apply the dots settings — remove DISABLE_AUTOUPDATER by hand."
fi
