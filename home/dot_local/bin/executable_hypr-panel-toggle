#!/usr/bin/env bash
# Super+Ctrl+B handler. Toggles waybar (SIGUSR1) when it's running.
# When it's not running — typically because waybar crashed — re-launches
# it AND kicks hyprlax, since hyprlax's IPC tends to wedge in the same
# events that take waybar down (monitor add/remove, lid close).
set -u

if pkill -SIGUSR1 waybar 2>/dev/null; then
    exit 0
fi

setsid -f waybar </dev/null >/dev/null 2>&1

pkill -9 -f 'hyprlax( |$)' 2>/dev/null
sleep 0.3
rm -f "/run/user/${UID}"/hyprlax-*.sock
setsid -f hyprlax --config "${HOME}/.config/hyprlax/hyprlax.toml" </dev/null >/dev/null 2>&1
