#!/usr/bin/env bash
# Wire the EQ virtual sink through Carla and out to the HDMI device.
#
# Carla is a JACK client, and JACK clients do not auto-connect — so every
# time Carla starts, its ports show up unlinked and audio stops at the sink.
# This script makes those links, and is idempotent: pw-link exits non-zero
# on an existing link, which we deliberately ignore.
#
# Invoked from carla-eq.service's ExecStartPost, but safe to run by hand.

set -uo pipefail

SINK_MONITOR="eq-in"
CARLA="Carla"
OUT_DEVICE="alsa_output.pci-0000_00_1f.3.hdmi-stereo"

# Carla registers its ports several seconds after the process starts, so
# poll rather than assuming they are present the moment systemd returns.
for _ in $(seq 1 40); do
    if pw-link -o 2>/dev/null | grep -q "^${CARLA}:audio-out1$"; then
        break
    fi
    sleep 0.5
done

if ! pw-link -o 2>/dev/null | grep -q "^${CARLA}:audio-out1$"; then
    echo "carla-eq-link: ${CARLA} ports never appeared — is Carla running?" >&2
    exit 1
fi

link() {
    # Already-linked is success for our purposes; anything else is a real error.
    if pw-link "$1" "$2" 2>/dev/null; then
        echo "linked  $1 -> $2"
    elif pw-link -l 2>/dev/null | grep -A1 -- "^$1\$" | grep -q -- "$2"; then
        echo "already $1 -> $2"
    else
        echo "FAILED  $1 -> $2" >&2
        return 1
    fi
}

# PipeWire auto-connects a JACK client to the default sink AND the default
# source. Both are wrong here: the output lands back on the sink feeding Carla
# (a feedback loop), and the default source — a microphone — gets mixed into
# playback. Neither is enumerable by name in advance, so strip every link on
# Carla's ports first and rebuild only the ones we want.
strip_foreign() {
    # Cut anything feeding Carla's inputs that is not the EQ sink's monitor.
    pw-link -l 2>/dev/null | awk -v carla="${CARLA}" -v keep="${SINK_MONITOR}" '
        /^[^ ]/ { port = $0; next }
        /\|<-/  {
            src = $2
            if (port ~ "^" carla ":audio-in" && src !~ "^" keep ":")
                print src, port
        }
    ' | while read -r src dst; do
        pw-link -d "$src" "$dst" 2>/dev/null && echo "cut input  $src -> $dst"
    done

    # Cut anything leaving Carla that is not the real output device.
    pw-link -l 2>/dev/null | awk -v carla="${CARLA}" -v keep="${OUT_DEVICE}" '
        /^[^ ]/ { port = $0; next }
        /\|->/  {
            dst = $2
            if (port ~ "^" carla ":audio-out" && dst !~ "^" keep ":")
                print port, dst
        }
    ' | while read -r src dst; do
        pw-link -d "$src" "$dst" 2>/dev/null && echo "cut output $src -> $dst"
    done
}
strip_foreign

rc=0
link "${SINK_MONITOR}:monitor_FL" "${CARLA}:audio-in1"  || rc=1
link "${SINK_MONITOR}:monitor_FR" "${CARLA}:audio-in2"  || rc=1
link "${CARLA}:audio-out1" "${OUT_DEVICE}:playback_FL"  || rc=1
link "${CARLA}:audio-out2" "${OUT_DEVICE}:playback_FR"  || rc=1

exit $rc
