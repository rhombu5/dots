#!/usr/bin/env bash
#
# claude-askpass — SUDO_ASKPASS helper that supplies tom's local
# password. Designed to run unattended in any shell context (Claude Code
# bash tool, cron, systemd --user services).
#
# Usage (via the `sudoa` zsh alias defined in ~/.zsh_aliases):
#   sudoa <cmd>     # = SUDO_ASKPASS=~/.local/bin/claude-askpass sudo -A <cmd>
#
# Two sources, tried in order:
#
#   1. libsecret, `service=sudo user=tom`. Requires no network and no
#      Bitwarden login. Seed it once with:
#          secret-tool store --label='metis local password (tom)' \
#              service sudo user tom
#      (secret-tool prompts on the terminal and does not echo, so the
#      password never lands in shell history or a tool transcript.)
#
#   2. The Bitwarden vault — the `metis.rhombus.rocks` SSH-Key item
#      carries the password in its `tom` custom field (alongside `luks`
#      and `root`). On a successful read this backfills source 1, so the
#      vault is consulted at most once per keyring.
#
# Source 1 exists because source 2 has a hard dependency on the
# self-hosted Vaultwarden at hass4150.duckdns.org, which went
# unreachable in June 2026 and eventually logged the CLI out entirely
# (`bw status` → "unauthenticated", local cache wiped, data.json.bak
# truncated). That took sudo down with it. Keeping a copy in libsecret
# means a dead vault server can no longer cost us privilege elevation.
#
# Trust model unchanged: anyone who can read the keyring can elevate.
# That was already true — libsecret holds the Bitwarden *master*
# password, which is strictly more powerful than this one.
#
# Bail conditions (each prints to stderr; sudo forwards askpass stderr
# to the user, so the message lands wherever the sudo invocation lives):
#   1. master password not in libsecret → run `bwu` interactively first
#   2. bw unlock failed → master password may have been rotated
#   3. ambiguous match → multiple Bitwarden items named metis.rhombus.rocks
#      (rare; rename or merge them in bw)
#   4. no match → metis.rhombus.rocks item doesn't exist (renamed?)
#   5. matched item has no `tom` custom field

set -euo pipefail

err() { printf 'claude-askpass: %s\n' "$*" >&2; }

# 0. Fast path — the password cached directly in libsecret. No network,
#    no Bitwarden login, works even with the vault server down.
cached="$(secret-tool lookup service sudo user tom 2>/dev/null || true)"
if [[ -n "$cached" ]]; then
    printf '%s\n' "$cached"
    exit 0
fi

# 1. Get a usable BW_SESSION. Try cached first; if locked/empty, unlock
#    silently using the master password from libsecret. Never prompt.
BW_SESSION="$(secret-tool lookup service bitwarden type session 2>/dev/null || true)"

needs_unlock=0
if [[ -z "$BW_SESSION" ]]; then
    needs_unlock=1
else
    status="$(BW_SESSION="$BW_SESSION" bw status 2>/dev/null | jq -r .status 2>/dev/null || true)"
    [[ "$status" != "unlocked" ]] && needs_unlock=1
fi

if (( needs_unlock )); then
    pw="$(secret-tool lookup service bitwarden user master 2>/dev/null || true)"
    if [[ -z "$pw" ]]; then
        err "no cached master password — run 'bwu' once interactively first"
        exit 1
    fi
    BW_SESSION="$(BW_PASSWORD="$pw" bw unlock --passwordenv BW_PASSWORD --raw 2>/dev/null || true)"
    unset pw
    if [[ -z "$BW_SESSION" ]]; then
        err "bw unlock failed — master password may be stale; rotate via bwu"
        exit 2
    fi
    # Refresh cached session for subsequent silent calls.
    printf '%s' "$BW_SESSION" \
        | secret-tool store \
            --label='Bitwarden CLI session' \
            service bitwarden type session 2>/dev/null || true
fi
export BW_SESSION

# 2. Find the metis.rhombus.rocks item, pull the `tom` custom field.
items_json="$(bw list items --search metis.rhombus.rocks 2>/dev/null || true)"
if [[ -z "$items_json" ]]; then
    err "bw list items returned empty — vault sync may be needed (\`bw sync\`)"
    exit 3
fi

matches="$(printf '%s' "$items_json" | jq -c '
    [ .[] | select(.name == "metis.rhombus.rocks") ]
' 2>/dev/null || true)"
if [[ -z "$matches" || "$matches" == "null" ]]; then
    err "jq parse failed on bw output"
    exit 4
fi

n="$(printf '%s' "$matches" | jq 'length' 2>/dev/null)"
if [[ "$n" -eq 0 ]]; then
    err "no Bitwarden item matched name=metis.rhombus.rocks"
    exit 5
fi
if [[ "$n" -gt 1 ]]; then
    err "ambiguous: $n Bitwarden items match name=metis.rhombus.rocks"
    exit 6
fi

password="$(printf '%s' "$matches" | jq -r '.[0].fields[]? | select(.name == "tom") | .value' 2>/dev/null)"
if [[ -z "$password" ]]; then
    err "matched item has no field named 'tom'"
    exit 7
fi

# 3. Backfill the libsecret fast path so the next call skips Bitwarden
#    entirely. Best-effort: a failure here must not break this sudo.
printf '%s' "$password" \
    | secret-tool store \
        --label='metis local password (tom)' \
        service sudo user tom 2>/dev/null || true

printf '%s\n' "$password"
