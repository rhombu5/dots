#!/usr/bin/env bash
# hypr-plugins-on-login — load Hyprland plugins + source per-plugin
# config inside an active Hyprland session. Called from exec.conf as
# `exec-once`.
#
# Why this lives outside hyprpm: hyprpm's load path needs
# HYPRLAND_INSTANCE_SIGNATURE to talk to the compositor — i.e., a live
# session. postinstall.sh runs from a TTY where no session exists; it
# can `hyprpm update && hyprpm add` (which only need sudo + hyprland
# headers) but actually loading the .so has to wait until first login.
# This script bridges that gap, runs once per session, idempotent on
# re-runs.
#
# hyprpm operates user-scoped (no sudo) — never triggers a TPM-PIN
# prompt, even with pinpam wired into the sudo PAM stack.
#
# Two-phase design:
#   1. Per-plugin `hyprpm enable` — flips state.toml on first-ever
#      login (no-op afterwards). Errors swallowed: this fails harmlessly
#      with "Failed to write plugin state" if something owns the cache
#      file root:root (a known regression after sudo-built warm-ups
#      from postinstall.sh §13). The reload below recovers anyway.
#   2. Single trailing `hyprpm reload` — "Ensure all enabled plugins
#      are loaded". This is the load primitive — `enable` on an
#      already-enabled plugin does NOT call `hyprctl plugin load` and
#      so does NOT load the .so into the running compositor. Without
#      this reload, plugins that were enabled in a previous session
#      (state.toml says enabled = true) silently fail to load.

set -u

if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    exit 0
fi

# Phase 0: sync runtime-monitors.conf to current lid truth BEFORE any
# reload below. Phase 2's `hyprpm reload` triggers a full config
# re-parse; this sync is what makes that re-parse (and every later
# `hyprctl reload`, e.g. a mid-session reload keybind) land on the
# correct clamshell state instead of resurrecting eDP-1 from
# monitors.conf — observed 2026-07-09 as a phantom eDP-1 doubling
# waybar bars + hyprmural surfaces while the lid had been closed for a
# week. See hypr-lid-sync for the mechanism.
"$HOME/.local/bin/hypr-lid-sync" || true

# The plugin phases below need hyprpm; phase 0 above doesn't.
if ! command -v hyprpm >/dev/null; then
    exit 0
fi

# Plugins we want loaded each session. KEY = plugin display name as
# `hyprpm list` reports (case-insensitive grep match), VALUE = filename
# stem in ~/.config/hypr/post-plugins.d/<stem>.conf.
#
# Hyprspace is built from the 0xl30/Hyprspace fork (PR #229 against
# KZDKM/Hyprspace) — the upstream HEAD post-PR-#223 crashes Hyprland
# 0.54.3 immediately on enable (issues #226/#227, fixed by PR #229
# which is open as of 2026-04-30). If the PR ever merges upstream,
# repoint hyprpm back at KZDKM/Hyprspace.
plugins=(
    "hyprgrass:hyprgrass"
    "Hyprspace:hyprspace"
)

for entry in "${plugins[@]}"; do
    name="${entry%%:*}"

    # Only act if hyprpm has the plugin built (was added by postinstall §13).
    if ! hyprpm list 2>/dev/null | grep -qi "$name"; then
        continue
    fi

    # Phase 1: ensure state.toml says enabled. No-op (and harmless
    # write-state errors) if already enabled — phase 2 recovers.
    hyprpm enable "$name" >/dev/null 2>&1 || true
done

# Phase 2: actually load any enabled-but-not-yet-loaded .so into the
# live compositor. This is the line that was missing and caused
# Hyprspace to silently fail to load on session start.
hyprpm reload >/dev/null 2>&1 || true

# Phase 3: source per-plugin config inside the live session, AFTER the
# .so is loaded (so dispatchers like `overview:toggle` are registered
# before bindd lines reference them).
for entry in "${plugins[@]}"; do
    name="${entry%%:*}"
    conf="${entry##*:}"

    if ! hyprpm list 2>/dev/null | grep -qi "$name"; then
        continue
    fi

    if [[ -f "$HOME/.config/hypr/post-plugins.d/${conf}.conf" ]]; then
        hyprctl keyword source "$HOME/.config/hypr/post-plugins.d/${conf}.conf" >/dev/null 2>&1 || true
    fi
done

# Phase 4: apply lid-closed clamshell disable immediately. Phase 0's sync
# means phase 2's reload already re-applied the correct eDP-1 state from
# runtime-monitors.conf — this keyword pass is belt-and-braces for paths
# where no reload fired after the sync (empty plugin list, swallowed
# hyprpm errors) and for the very first parse of the session, which read
# whatever runtime-monitors.conf the PREVIOUS session left behind.
#
# Inline (rather than calling lid-handler close) so the battery/no-external
# else-branch (systemctl hibernate) cannot fire from a config reload — that
# branch is the binddl's job, not ours.
if awk '/state/ {print $2}' /proc/acpi/button/lid/*/state 2>/dev/null | grep -q closed \
    && [[ "$(cat /sys/class/power_supply/AC/online 2>/dev/null)" == 1 ]] \
    && hyprctl monitors -j 2>/dev/null | jq -e 'any(.[]; .name != "eDP-1")' >/dev/null; then
    hyprctl keyword monitor "eDP-1,disable" >/dev/null 2>&1 || true
fi
