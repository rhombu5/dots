#!/bin/sh
# if-scrollmode <hyprctl-dispatch-args...>
#
# Run `hyprctl dispatch <args>` ONLY if current Hyprland layout is
# scroller (hyprscroller plugin). Counterpart to if-tilemode — see
# that file for design notes.

[ "$(hyprctl getoption general:layout -j 2>/dev/null | jq -r '.str // empty')" = "scroller" ] || exit 0
exec hyprctl dispatch "$@"
