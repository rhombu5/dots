#!/usr/bin/env python3
"""wpws — per-workspace wallpaper + dynamic accent for Hyprland.

Architecture:
  * Wallpaper:  one wide stitched canvas (all pool images crop-fit to
                monitor size, concatenated horizontally, rotated by
                offset). Displayed via `hyprlax`, which pans the
                viewport by one monitor-width per workspace switch.
                Going from ws 1 → ws 5 sweeps through 2, 3, 4 in the
                same duration as a single-step pan — windows take the
                straight path, wallpaper takes the scenic route.
  * Accent:     extracted from the *original* per-workspace wallpaper
                (not the stitched canvas) by a tiny PIL dominant-color
                routine. Pushed live via `hyprctl keyword` (borders +
                groupbar) and atomic-mv'd into ~/.config/themes/
                accent.{css,conf,ini} (waybar, swaync, fuzzel).
  * matugen     still owns the slow path — full M3 palette for GTK,
                Qt, helix, ghostty, tmux, yazi, zathura, hyprlock,
                regreet — fired by ~/.local/bin/wallpaper-rotate.

Subcommands:
  daemon            Long-running. Started by exec-once in exec.conf.
  switch <ws> [out] Apply accent for workspace `ws`.
  rotate            Increment offset → restitch + restart hyprlax.
  status            Print current state + assignment table.
  theme <image>     Pre-warm the palette cache for one wallpaper.
"""

from __future__ import annotations

import colorsys
import hashlib
import json
import os
import socket
import subprocess
import sys
import time
import tomllib
from pathlib import Path

HOME = Path.home()
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
CACHE_ROOT = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "wpws"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "wpws"

DEFAULT_CONFIG: dict = {
    "pool": {
        "dir": str(HOME / "Pictures" / "Wallpapers"),
        "extensions": [".jpg", ".jpeg", ".png", ".webp"],
    },
    "targets": {
        "themes_dir": str(HOME / ".config" / "themes"),
    },
    "reload": {
        "hooks": [
            "pkill -SIGUSR2 waybar 2>/dev/null || true",
            "swaync-client --reload-css 2>/dev/null || true",
        ],
    },
    "debounce": {
        "min_interval_seconds": 0.05,
    },
    "hyprlax": {
        # Total animation duration in seconds. Constant regardless of
        # workspace jump distance — see hyprlax `--duration`.
        "duration": "0.3",
        # Easing curve. linear / sine / expo / elastic / etc per hyprlax docs.
        "easing": "expo",
    },
}

# Hyprland keywords pushed live on every accent update. Templates support
# {primary}, {on_primary}, {primary_container}, {on_primary_container},
# {secondary}, {tertiary}, {error}.
HYPR_KEYWORDS = [
    "general:col.active_border rgb({primary}) rgb({tertiary}) 45deg",
    "group:col.border_active rgb({primary}) rgb({tertiary}) 45deg",
    "group:groupbar:col.active rgb({primary_container})",
    "group:groupbar:text_color rgb({on_primary_container})",
]


# -------- config + paths -------------------------------------------------

def expand(p: str) -> Path:
    return Path(os.path.expanduser(os.path.expandvars(p)))


def load_config() -> dict:
    cfg = {k: dict(v) if isinstance(v, dict) else v for k, v in DEFAULT_CONFIG.items()}
    f = CONFIG_DIR / "config.toml"
    if f.exists():
        with open(f, "rb") as fh:
            user = tomllib.load(fh)
        for section, values in user.items():
            if isinstance(values, dict):
                cfg.setdefault(section, {}).update(values)
            else:
                cfg[section] = values
    return cfg


def themes_dir(cfg: dict) -> Path:
    return expand(cfg["targets"]["themes_dir"])


def cache_for(wallpaper: Path) -> Path:
    h = hashlib.sha256(str(wallpaper.resolve()).encode()).hexdigest()
    return CACHE_ROOT / "themes" / h


def read_offset() -> int:
    f = CACHE_ROOT / "offset"
    if not f.exists():
        return 0
    try:
        return int(f.read_text().strip() or "0")
    except ValueError:
        return 0


def write_offset(n: int) -> None:
    CACHE_ROOT.mkdir(parents=True, exist_ok=True)
    (CACHE_ROOT / "offset").write_text(str(n))


# -------- pool + assignment ----------------------------------------------

def list_pool(cfg: dict) -> list[Path]:
    d = expand(cfg["pool"]["dir"])
    if not d.is_dir():
        return []
    exts = {e.lower() for e in cfg["pool"]["extensions"]}
    return sorted(p for p in d.iterdir() if p.is_file() and p.suffix.lower() in exts)


def wallpaper_for(ws_id: int, pool: list[Path], offset: int) -> Path | None:
    if not pool:
        return None
    return pool[(ws_id - 1 + offset) % len(pool)]


# -------- hyprland helpers -----------------------------------------------

def hyprctl_json(*args: str):
    out = subprocess.check_output(["hyprctl", "-j", *args], text=True)
    return json.loads(out)


def focused_ws_and_output() -> tuple[int, str]:
    aw = hyprctl_json("activeworkspace")
    return int(aw["id"]), aw["monitor"]


def focused_monitor() -> dict:
    monitors = hyprctl_json("monitors")
    for m in monitors:
        if m.get("focused"):
            return m
    return monitors[0] if monitors else {"width": 1920, "height": 1080, "name": ""}


def push_keywords(palette: dict[str, str]) -> None:
    parts = [f"keyword {tpl.format(**palette)}" for tpl in HYPR_KEYWORDS]
    subprocess.run(
        ["hyprctl", "--batch", " ; ".join(parts)],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def run_hooks(cfg: dict) -> None:
    for hook in cfg["reload"]["hooks"]:
        subprocess.run(["sh", "-c", hook], check=False)


# -------- stitch + hyprlax ------------------------------------------------

# Number of workspace slots in the stitched canvas. 9 covers Hyprland's
# typical 1..9 keyboard binds; the canvas is halved (per-slot 960×540
# instead of 1920×1080) to keep the total width under GL_MAX_TEXTURE_SIZE
# (typically 16384 — anything wider renders solid grey from GL_INVALID_VALUE).
# Half-res is fine because hyprlax samples through `fit = "fit_height"`
# which scales the layer back up to monitor size; the perceptible quality
# loss on a 1920×1080 panel is negligible for chrome wallpaper.
NUM_SLOTS = 9
SLOT_SCALE = 0.5


def slot_sequence(pool: list[Path], offset: int, n: int) -> list[Path]:
    """Wallpaper for canvas slots 0..n-1. Slot i = pool[(i + offset) %
    len(pool)] — straight rotation. Workspace alignment is handled by
    hyprlax's `tile.x = true` (canvas wraps cyclically) so we don't
    need the start-ws anchoring tricks anymore."""
    return [pool[(i + offset) % len(pool)] for i in range(n)]


def stitch_key(pool: list[Path], offset: int, mw: int, mh: int) -> str:
    seq = slot_sequence(pool, offset, NUM_SLOTS)
    src = "|".join(p.name for p in seq) + f"|{mw}x{mh}|n{NUM_SLOTS}|s{SLOT_SCALE}"
    return hashlib.sha256(src.encode()).hexdigest()[:16]


def stitch_wide(pool: list[Path], offset: int, mw: int, mh: int) -> Path:
    """Build (or return cached) wide image: NUM_SLOTS wallpapers crop-fit
    to (mw, mh) × SLOT_SCALE, concatenated horizontally. Cached at
    ~/.cache/wpws/wide/<key>.png. Atomic write."""
    if not pool:
        raise RuntimeError("wpws: cannot stitch — pool is empty")
    out = CACHE_ROOT / "wide" / f"{stitch_key(pool, offset, mw, mh)}.png"
    if out.exists():
        return out
    out.parent.mkdir(parents=True, exist_ok=True)
    tmp = out.with_suffix(".partial.png")
    tmp.unlink(missing_ok=True)

    sw = max(1, int(mw * SLOT_SCALE))
    sh = max(1, int(mh * SLOT_SCALE))
    seq = slot_sequence(pool, offset, NUM_SLOTS)
    args = ["magick"]
    for p in seq:
        args += [
            "(", str(p),
            "-resize", f"{sw}x{sh}^",
            "-gravity", "center",
            "-extent", f"{sw}x{sh}",
            ")",
        ]
    args += ["+append", str(tmp)]
    subprocess.run(args, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    tmp.replace(out)
    return out


# Surgical update of two specific keys in the chezmoi-managed
# ~/.config/hyprlax/hyprlax.toml. Replaces the line containing `path = ...`
# (presumed to be the layer path) and the line containing
# `shift_percent = ...`. Leaves everything else alone, including comments
# and any other hand-tuned settings.
def update_hyprlax_toml(wide: Path, n_slots: int) -> tuple[bool, bool]:
    """Returns (path_updated, shift_updated). False means the key wasn't
    present and the user should add it manually."""
    toml = expand("~/.config/hyprlax/hyprlax.toml")
    if not toml.exists():
        return (False, False)
    pct = 100.0 / n_slots
    new_path_line = f'path = "{wide}"\n'
    new_shift_line = f'shift_percent = {pct:.5f}\n'
    path_ok = shift_ok = False
    out_lines = []
    for line in toml.read_text().splitlines(keepends=True):
        s = line.lstrip()
        # Match `path = "..."` (uncommented). Comments preserved.
        if not path_ok and (s.startswith('path =') or s.startswith('path=')) \
                and not s.startswith('#'):
            indent = line[: len(line) - len(s)]
            out_lines.append(indent + new_path_line)
            path_ok = True
            continue
        if not shift_ok and (s.startswith('shift_percent =') or s.startswith('shift_percent=')) \
                and not s.startswith('#'):
            indent = line[: len(line) - len(s)]
            out_lines.append(indent + new_shift_line)
            shift_ok = True
            continue
        out_lines.append(line)
    toml.write_text(''.join(out_lines))
    return (path_ok, shift_ok)


# wpws used to generate ~/.config/hyprlax/hyprlax.toml and respawn
# hyprlax on every restart. That ownership is gone — the user owns the
# TOML (chezmoi-managed) and Hyprland's exec-once owns the spawn.
# wpws now only:
#   - stitches the wide canvas on demand (via `wpws stitch`)
#   - pushes per-workspace accent colors on every workspace event


# -------- palette extraction (per original wallpaper) --------------------

def _hex(rgb: tuple[int, int, int]) -> str:
    r, g, b = rgb
    return f"{r:02x}{g:02x}{b:02x}"


def _rel_luminance_simple(r: int, g: int, b: int) -> float:
    return 0.299 * r / 255 + 0.587 * g / 255 + 0.114 * b / 255


def _rel_luminance_wcag(r: int, g: int, b: int) -> float:
    def chan(c: int) -> float:
        x = c / 255
        return x / 12.92 if x <= 0.03928 else ((x + 0.055) / 1.055) ** 2.4
    return 0.2126 * chan(r) + 0.7152 * chan(g) + 0.0722 * chan(b)


def _contrast_ratio(rgb_a, rgb_b) -> float:
    la, lb = _rel_luminance_wcag(*rgb_a), _rel_luminance_wcag(*rgb_b)
    lighter, darker = (la, lb) if la > lb else (lb, la)
    return (lighter + 0.05) / (darker + 0.05)


_BG_RGB: tuple[int, int, int] = (0x1e, 0x1e, 0x1e)
_MIN_CONTRAST = 4.5


def _boost_for_contrast(r: int, g: int, b: int) -> tuple[int, int, int]:
    """Raise lightness in HSL until WCAG contrast vs the dark background
    clears _MIN_CONTRAST. Hue + saturation preserved. Caps at L=0.92."""
    h, l, s = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
    rgb = (r, g, b)
    while _contrast_ratio(rgb, _BG_RGB) < _MIN_CONTRAST and l < 0.92:
        l = min(0.92, l + 0.04)
        nr, ng, nb = colorsys.hls_to_rgb(h, l, s)
        rgb = (int(nr * 255), int(ng * 255), int(nb * 255))
    return rgb


def extract_palette(wallpaper: Path) -> dict[str, str]:
    from PIL import Image

    img = Image.open(wallpaper).convert("RGB").resize((100, 100))
    quantized = img.quantize(colors=8).convert("RGB")
    counts = quantized.getcolors(maxcolors=256) or []

    def score(item):
        count, rgb = item
        r, g, b = rgb
        h, l, s = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
        if s < 0.15 or l < 0.15 or l > 0.9:
            return -1
        return s * (1 - abs(0.55 - l)) * count

    if counts:
        best = max(counts, key=score)
        if score(best) < 0:
            best = max(counts, key=lambda c: c[0])
    else:
        best = (1, (147, 205, 246))

    r, g, b = best[1]
    r, g, b = _boost_for_contrast(r, g, b)
    h, l, s = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)

    cr, cg, cb = colorsys.hls_to_rgb(h, max(0.18, l * 0.45), s * 0.6)
    container = (int(cr * 255), int(cg * 255), int(cb * 255))

    on_primary = (0, 0, 0) if _rel_luminance_simple(r, g, b) > 0.55 else (255, 255, 255)
    on_container = (255, 255, 255) if _rel_luminance_simple(*container) <= 0.55 else (0, 0, 0)

    sh = (h + 1 / 12) % 1.0
    th = (h + 1 / 6) % 1.0
    sr, sg, sb = colorsys.hls_to_rgb(sh, l, s * 0.7)
    tr, tg, tb = colorsys.hls_to_rgb(th, l, s * 0.7)
    secondary = _boost_for_contrast(int(sr * 255), int(sg * 255), int(sb * 255))
    tertiary = _boost_for_contrast(int(tr * 255), int(tg * 255), int(tb * 255))

    return {
        "primary": _hex((r, g, b)),
        "on_primary": _hex(on_primary),
        "primary_container": _hex(container),
        "on_primary_container": _hex(on_container),
        "secondary": _hex(secondary),
        "tertiary": _hex(tertiary),
        "error": "ffb4ab",
        "on_error": "690005",
    }


def palette_cached(wallpaper: Path) -> dict[str, str]:
    cdir = cache_for(wallpaper)
    pjson = cdir / "palette.json"
    if pjson.exists():
        try:
            return json.loads(pjson.read_text())
        except (json.JSONDecodeError, OSError):
            pass
    palette = extract_palette(wallpaper)
    cdir.mkdir(parents=True, exist_ok=True)
    pjson.write_text(json.dumps(palette))
    return palette


# -------- theme files (atomic writes) ------------------------------------

def render_css(p: dict[str, str]) -> str:
    return (
        f"@define-color primary             #{p['primary']};\n"
        f"@define-color on-primary          #{p['on_primary']};\n"
        f"@define-color primary-container   #{p['primary_container']};\n"
        f"@define-color on-primary-container #{p['on_primary_container']};\n"
        f"@define-color secondary           #{p['secondary']};\n"
        f"@define-color tertiary            #{p['tertiary']};\n"
        f"@define-color error               #{p['error']};\n"
        f"@define-color on-error            #{p['on_error']};\n"
    )


def render_conf(p: dict[str, str]) -> str:
    return (
        f"$primary              = rgb({p['primary']})\n"
        f"$on_primary           = rgb({p['on_primary']})\n"
        f"$primary_container    = rgb({p['primary_container']})\n"
        f"$on_primary_container = rgb({p['on_primary_container']})\n"
        f"$secondary            = rgb({p['secondary']})\n"
        f"$tertiary             = rgb({p['tertiary']})\n"
        f"$error                = rgb({p['error']})\n"
    )


def render_ini(p: dict[str, str]) -> str:
    return (
        "[colors]\n"
        f"match={p['primary']}ff\n"
        f"selection={p['primary_container']}ff\n"
        f"selection-text={p['on_primary_container']}ff\n"
        f"selection-match={p['primary']}ff\n"
        f"border={p['primary']}ff\n"
    )


def write_theme(palette: dict[str, str], target_dir: Path) -> None:
    target_dir.mkdir(parents=True, exist_ok=True)
    files = {
        "accent.css": render_css(palette),
        "accent.conf": render_conf(palette),
        "accent.ini": render_ini(palette),
    }
    for name, content in files.items():
        tmp = target_dir / f".{name}.tmp"
        tmp.write_text(content)
        tmp.replace(target_dir / name)


# -------- accent application (no wallpaper change — hyprlax owns that) ---

def apply_accent(ws_id: int, cfg: dict) -> None:
    pool = list_pool(cfg)
    if not pool:
        return
    wp = wallpaper_for(ws_id, pool, read_offset())
    if wp is None:
        return
    palette = palette_cached(wp)
    write_theme(palette, themes_dir(cfg))
    push_keywords(palette)
    run_hooks(cfg)
    CACHE_ROOT.mkdir(parents=True, exist_ok=True)
    (CACHE_ROOT / "current").write_text(f"{ws_id}\t{wp}\n")


def stitch_only(cfg: dict) -> Path | None:
    """Build (or fetch from cache) the wide canvas. Does NOT touch
    hyprlax — the user wires that themselves via the chezmoi-managed
    ~/.config/hyprlax/hyprlax.toml."""
    pool = list_pool(cfg)
    if not pool:
        return None
    mon = focused_monitor()
    return stitch_wide(pool, read_offset(), mon["width"], mon["height"])


# -------- subcommands ----------------------------------------------------

def cmd_daemon(cfg: dict) -> None:
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig:
        sys.exit("wpws: HYPRLAND_INSTANCE_SIGNATURE not set; run inside Hyprland.")
    sock_path = RUNTIME / "hypr" / sig / ".socket2.sock"

    # Initial accent push for the focused workspace. (Hyprlax is owned
    # by exec-once and ~/.config/hyprlax/hyprlax.toml — wpws no longer
    # spawns it.)
    try:
        ws, _ = focused_ws_and_output()
        apply_accent(ws, cfg)
    except Exception as e:  # noqa: BLE001
        print(f"wpws: initial accent apply failed: {e}", file=sys.stderr)

    # Listen for workspace events; on each, update accent (hyprlax handles
    # the wallpaper pan itself via its own IPC listener).
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(str(sock_path))
    f = s.makefile("r")

    debounce = float(cfg["debounce"]["min_interval_seconds"])
    last = 0.0
    for raw in f:
        line = raw.strip()
        if not line or ">>" not in line:
            continue
        event, payload = line.split(">>", 1)
        if event != "workspacev2":
            continue
        now = time.monotonic()
        if now - last < debounce:
            last = now
            continue
        last = now
        try:
            ws_id = int(payload.split(",", 1)[0])
            apply_accent(ws_id, cfg)
        except Exception as e:  # noqa: BLE001
            print(f"wpws: event handling failed: {e}", file=sys.stderr)


def cmd_switch(args: list[str], cfg: dict) -> None:
    if not args:
        sys.exit("usage: wpws switch <ws> [output]")
    ws_id = int(args[0])
    apply_accent(ws_id, cfg)


def cmd_rotate(cfg: dict) -> None:
    pool = list_pool(cfg)
    if not pool:
        sys.exit(f"wpws: pool empty: {cfg['pool']['dir']}")
    write_offset((read_offset() + 1) % len(pool))
    # Re-stitching the canvas is now an explicit step (`wpws stitch`)
    # because the canvas's pool/order is hand-curated. `wpws rotate`
    # only changes the offset and re-applies the accent for the focused
    # workspace.
    ws, _ = focused_ws_and_output()
    apply_accent(ws, cfg)


def cmd_stitch(cfg: dict) -> None:
    """Stitch the wide canvas, then surgically update path +
    shift_percent in ~/.config/hyprlax/hyprlax.toml. Reload hyprlax
    yourself to pick up the new image:
        pkill hyprlax; setsid -f hyprlax --config ~/.config/hyprlax/hyprlax.toml </dev/null >/dev/null 2>&1"""
    out = stitch_only(cfg)
    if out is None:
        sys.exit(f"wpws: pool empty: {cfg['pool']['dir']}")
    pct = 100.0 / NUM_SLOTS
    path_ok, shift_ok = update_hyprlax_toml(out, NUM_SLOTS)
    print(f"canvas:        {out}")
    print(f"slots:         {NUM_SLOTS}")
    print(f"shift_percent: {pct:.5f}  (= 100 / {NUM_SLOTS})")
    if not path_ok or not shift_ok:
        warnings = []
        if not path_ok:
            warnings.append("`path = \"...\"` line in [[global.layers]]")
        if not shift_ok:
            warnings.append("`shift_percent = ...` line in [global]")
        print(file=sys.stderr)
        print(
            "warning: hyprlax.toml didn't have the expected key(s) — couldn't update:",
            file=sys.stderr,
        )
        for w in warnings:
            print(f"  - {w}", file=sys.stderr)
        print(
            "  Add them by hand and re-run `wpws stitch` so future updates land.",
            file=sys.stderr,
        )


def cmd_status(cfg: dict) -> None:
    pool = list_pool(cfg)
    print(f"pool dir:   {cfg['pool']['dir']}")
    print(f"pool size:  {len(pool)}")
    print(f"offset:     {read_offset()}")
    cur = CACHE_ROOT / "current"
    if cur.exists():
        ws, wp = cur.read_text().strip().split("\t", 1)
        print(f"focused ws: {ws}")
        print(f"wallpaper:  {wp}")
    if pool:
        mon = focused_monitor()
        key = stitch_key(pool, read_offset(), mon["width"], mon["height"])
        wide = CACHE_ROOT / "wide" / f"{key}.png"
        print(f"wide cache: {wide} ({'present' if wide.exists() else 'will-build'})")
        print()
        print("workspace -> wallpaper assignment (with current offset):")
        for i in range(1, min(len(pool), 9) + 1):
            wp = wallpaper_for(i, pool, read_offset())
            print(f"  ws {i}: {wp.name if wp else '(none)'}")


def cmd_theme(args: list[str], cfg: dict) -> None:
    if not args:
        sys.exit("usage: wpws theme <image>")
    wp = expand(args[0])
    if not wp.is_file():
        sys.exit(f"wpws: not a file: {wp}")
    palette = palette_cached(wp)
    print(json.dumps(palette, indent=2))


# -------- entry ----------------------------------------------------------

def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0 if len(sys.argv) >= 2 else 1)
    cfg = load_config()
    cmd, args = sys.argv[1], sys.argv[2:]
    handlers = {
        "daemon": lambda: cmd_daemon(cfg),
        "switch": lambda: cmd_switch(args, cfg),
        "rotate": lambda: cmd_rotate(cfg),
        "stitch": lambda: cmd_stitch(cfg),
        "status": lambda: cmd_status(cfg),
        "theme": lambda: cmd_theme(args, cfg),
    }
    if cmd not in handlers:
        sys.exit(f"wpws: unknown command: {cmd!r}\n{__doc__}")
    handlers[cmd]()


if __name__ == "__main__":
    main()
