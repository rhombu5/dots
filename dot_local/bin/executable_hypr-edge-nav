#!/bin/sh
# hypr-edge-nav <focus|move> <l|r>
#
# Edge-aware focus/move on the left↔right axis. Escalates to a
# workspace switch when the active window is the geometric edge
# window on its workspace.
#
#   focus l|r : if at edge, switch workspace and focus the leftmost
#               (going right) / rightmost (going left) window on the
#               new workspace. Otherwise plain `movefocus`.
#
#   move  l|r : if at edge, `movetoworkspace +1` / `-1` and then loop
#               `movewindow` in the opposite direction until the
#               position stops changing — so the window lands at the
#               far left of the next workspace (or far right of the
#               previous one). Otherwise plain `movewindow`.
#
# Edge detection is geometric, not based on `movefocus`/`movewindow`
# return: count other mapped clients on the same workspace whose
# horizontal centre is past ours in the requested direction. Zero =
# we're the edge window.
#
# Why geometric: relying on "did movefocus change the active window?"
# is fragile — Hyprland's wrap/cycle behaviours and floating windows
# can make it report a focus change even when no real-rightward
# motion happened.
#
# Workspace target is `+1` / `-1` (numeric next/prev). Predictable;
# the focus variant degrades gracefully on an empty workspace.

set -eu

mode=${1:-}
dir=${2:-}

case "$mode" in focus|move) ;; *)
    echo "usage: hypr-edge-nav <focus|move> <l|r>" >&2; exit 2 ;;
esac
case "$dir" in l|r) ;; *)
    echo "usage: hypr-edge-nav <focus|move> <l|r>" >&2; exit 2 ;;
esac

active=$(hyprctl -j activewindow 2>/dev/null || echo '{}')
self_addr=$(printf '%s' "$active" | jq -r '.address // empty')
[ -n "$self_addr" ] || exit 0

ws=$(printf '%s' "$active" | jq -r '.workspace.id // empty')
center_x=$(printf '%s' "$active" | jq -r 'if .at and .size then (.at[0] + .size[0]/2) else empty end')
[ -n "$ws" ] && [ -n "$center_x" ] || exit 0

# Count other mapped clients on this workspace whose centre is past
# ours in the requested direction. Zero → we're the edge window.
if [ "$dir" = r ]; then op='>'; else op='<'; fi
others=$(hyprctl -j clients 2>/dev/null | jq --arg self "$self_addr" --argjson ws "$ws" --argjson cx "$center_x" "
    [ .[]
      | select(.workspace.id == \$ws)
      | select(.mapped)
      | select(.address != \$self)
      | select((.at[0] + .size[0]/2) $op \$cx)
    ] | length")

if [ "${others:-0}" -gt 0 ]; then
    # Not at edge — let the plain dispatcher run.
    if [ "$mode" = focus ]; then
        exec hyprctl dispatch movefocus "$dir" >/dev/null
    else
        exec hyprctl dispatch movewindow "$dir" >/dev/null
    fi
fi

# At edge — escalate to the next/prev workspace.
if [ "$dir" = r ]; then ws_target='+1'; else ws_target='-1'; fi

if [ "$mode" = focus ]; then
    # Skip empty workspaces. The semantic is "focus the next window
    # rightward/leftward" — landing on an empty workspace would mean
    # nothing got focused, which violates that contract. Find the
    # nearest populated workspace strictly past `$ws`; if none exists
    # in that direction, do nothing.
    if [ "$dir" = r ]; then ws_filter='select(.id > $cur)'; ws_sort='sort_by(.id)';        else ws_filter='select(.id < $cur)'; ws_sort='sort_by(.id) | reverse'; fi
    if [ "$dir" = r ]; then win_sort='sort_by(.at[0])';                                     else win_sort='sort_by(.at[0]) | reverse';                                       fi
    target_ws=$(hyprctl -j workspaces 2>/dev/null | jq -r --argjson cur "$ws" "
        [ .[] | select(.id > 0) | select(.windows > 0) | $ws_filter ]
        | $ws_sort | .[0].id // empty")
    [ -n "$target_ws" ] || exit 0
    hyprctl dispatch workspace "$target_ws" >/dev/null 2>&1 || exit 0
    target=$(hyprctl -j clients 2>/dev/null \
        | jq -r --argjson ws "$target_ws" \
            "[.[] | select(.workspace.id == \$ws) | select(.mapped)] | $win_sort | .[0].address // empty")
    [ -n "$target" ] && hyprctl dispatch focuswindow "address:$target" >/dev/null 2>&1 || true
    exit 0
fi

# mode = move : carry the window over and settle it at the leading
# edge of the destination workspace.
#
# Travel direction → target edge:
#   dir=r (moved into a higher-id ws) → land at the LEFT edge.
#   dir=l (moved into a lower-id  ws) → land at the RIGHT edge.
#
# How "land at edge" is achieved depends on the destination layout:
#
#   dwindle   — push with `movewindow` until the position stops
#               changing. dwindle's movewindow is non-wrapping, so
#               position-equality is a valid loop guard.
#
#   scrolling — `wrap_swapcol` defaults to true (per Hyprland docs),
#               so position-equality would loop forever. Instead we
#               promote the window to its own column (so it doesn't
#               accidentally join the column it landed in), then loop
#               `layoutmsg swapcol` while the geometric edge check
#               says there's still a column past us in the push
#               direction.

# Pre-jump check (scrolling source only): if the focused window is in
# the geometric edge column but shares that column with another
# window (same at[0]), defer to plain `movewindow` instead of
# jumping. The built-in handler promotes the window out into its own
# column on the desired side; the *next* press, when the window is
# alone in the column, escalates to the workspace jump.
src_layout=$(hyprctl -j activeworkspace 2>/dev/null | jq -r '.tiledLayout // "dwindle"')
if [ "$src_layout" = scrolling ]; then
    self_x=$(printf '%s' "$active" | jq -r '.at[0] // empty')
    if [ -n "$self_x" ]; then
        column_mates=$(hyprctl -j clients 2>/dev/null | jq --arg self "$self_addr" --argjson ws "$ws" --argjson sx "$self_x" '
            [ .[]
              | select(.workspace.id == $ws)
              | select(.mapped)
              | select(.address != $self)
              | select(.at[0] == $sx)
            ] | length')
        if [ "${column_mates:-0}" -gt 0 ]; then
            exec hyprctl dispatch movewindow "$dir" >/dev/null
        fi
    fi
fi

hyprctl dispatch movetoworkspace "$ws_target" >/dev/null 2>&1 || exit 0

if [ "$dir" = r ]; then push=l; opp_op='<'; else push=r; opp_op='>'; fi
dest_layout=$(hyprctl -j activeworkspace 2>/dev/null | jq -r '.tiledLayout // "dwindle"')

case "$dest_layout" in
    scrolling)
        hyprctl dispatch layoutmsg promote >/dev/null 2>&1 || true
        i=0
        while [ $i -lt 32 ]; do
            cur=$(hyprctl -j activewindow 2>/dev/null)
            self=$(printf '%s' "$cur" | jq -r '.address // empty')
            cx=$(printf '%s' "$cur" | jq -r 'if .at and .size then (.at[0] + .size[0]/2) else empty end')
            new_ws=$(printf '%s' "$cur" | jq -r '.workspace.id // empty')
            [ -n "$self" ] && [ -n "$cx" ] && [ -n "$new_ws" ] || break
            others=$(hyprctl -j clients 2>/dev/null | jq --arg self "$self" --argjson ws "$new_ws" --argjson cx "$cx" "
                [ .[]
                  | select(.workspace.id == \$ws)
                  | select(.mapped)
                  | select(.address != \$self)
                  | select((.at[0] + .size[0]/2) $opp_op \$cx)
                ] | length")
            [ "${others:-0}" -eq 0 ] && break
            hyprctl dispatch layoutmsg "swapcol $push" >/dev/null 2>&1 || break
            i=$((i + 1))
        done
        ;;
    *)
        prev=""
        i=0
        while [ $i -lt 16 ]; do
            cur=$(hyprctl -j activewindow 2>/dev/null | jq -r 'if .at then "\(.at[0]),\(.at[1])" else "" end')
            [ "$cur" = "$prev" ] && break
            prev=$cur
            hyprctl dispatch movewindow "$push" >/dev/null 2>&1 || break
            i=$((i + 1))
        done
        ;;
esac
