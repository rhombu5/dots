#!/bin/sh
# hypr-layout-toggle — cycle between dwindle and scrolling.
#
# Bound to Super+Alt+S in binds.conf.
#
# Hyprland 0.54+ ships scrolling as a CORE layout (no plugin needed).
# The keyword call below is just a config-time keyword update — works
# instantly, no reload required.

set -e

current=$(hyprctl getoption general:layout -j 2>/dev/null | jq -r '.str // "dwindle"')

case "$current" in
    scrolling) target=dwindle ;;
    *)         target=scrolling ;;
esac

if hyprctl keyword general:layout "$target" >/dev/null 2>&1; then
    notify-send -t 1500 "Hyprland layout" "→ $target" 2>/dev/null || true
else
    notify-send -u critical -t 3000 "Hyprland layout" "Failed to set layout=$target." 2>/dev/null || true
    exit 1
fi
