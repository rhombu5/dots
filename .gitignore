# chezmoi state lives outside the source tree (~/.config/chezmoi/),
# but a stray init can drop a config in-tree — ignore it.
/chezmoi.toml
/chezmoi.yaml

# Editor / OS noise
/.vscode/
/.idea/
.DS_Store
Thumbs.db

# package.json `prepare` script wires up .githooks; node_modules itself
# is not needed (we have no dependencies — npm install is just for the
# lifecycle hook).
/node_modules/
/package-lock.json

# Crash artifacts
*.stackdump
